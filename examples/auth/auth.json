{
    "providers": {
        "company": {
            "type": "oidc",
            "label": "Company account",
            "issuer": "https://identity.example.com/realms/company",
            "client_id": "extplorer",
            "client_secret_file": "/run/secrets/extplorer_oidc_client_secret",
            "base_role": "user",
            "group_map": {
                "extplorer-users": []
            },
            "group_claims": [
                "groups",
                "realm_access.roles"
            ],
            "rp_logout_enabled": false,
            "backchannel_logout_enabled": false,
            "webdav_enabled": false,
            "webdav_ttl_seconds": 2592000
        }
    }
}
