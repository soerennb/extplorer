services:
  extplorer-app:
    # The wrapper stages chmod-600 host secrets for www-data and then starts
    # PHP-FPM as UID 82. The runtime process therefore remains non-root.
    user: "0:0"
    # These capabilities are used only by the root wrapper while it prepares
    # the writable tree and stages secrets. su-exec drops them with PHP-FPM.
    cap_add:
      - CHOWN
      - DAC_OVERRIDE
      - SETGID
      - SETUID
    environment:
      EXTPLORER_ADMIN_PASSWORD_FILE: /run/secrets/extplorer_admin_password
    secrets:
      - extplorer_admin_password

secrets:
  extplorer_admin_password:
    file: ${EXTPLORER_ADMIN_PASSWORD_HOST_FILE:?Set EXTPLORER_ADMIN_PASSWORD_HOST_FILE to a chmod-600 file}
